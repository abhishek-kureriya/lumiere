}

.option-buttons {
  display: flex;
  gap: 0.6rem;
  flex-wrap: wrap;
}

.option-buttons input[type="radio"] {
  display: none;
}

.option-btn {
  padding: 0.7rem 1.3rem;
  border: 2px solid #ddd;
  border-radius: 6px;
  cursor: pointer;
  transition: all 0.3s;
  font-size: 0.9rem;
