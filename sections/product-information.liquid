{% comment %}
===========================================
PRODUCT PAGE - LUMIÈRE (FINAL + CART UPDATE + FIXED ZOOM)
- Dynamic cart count update
- Payment trust badges
- Swipe functionality
- WORKING ZOOM FUNCTIONALITY
===========================================
{% endcomment %}

<div class="product-lumiere-page">
  
  {%- comment -%} Title Section (Top) {%- endcomment -%}
  <div class="product-title-bar">
    <div class="title-container">
      <h1 class="product-main-title">{{ product.title }}</h1>
      <div class="product-main-price">
        {%- if product.compare_at_price > product.price -%}
          <span class="price-current">{{ product.price | money }}</span>
          <span class="price-original">{{ product.compare_at_price | money }}</span>
          <span class="sale-tag">SALE</span>
        {%- else -%}
          <span class="price-current">{{ product.price | money }}</span>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- comment -%} Main Content {%- endcomment -%}
  <div class="product-main-content">
    
    {%- comment -%} Image Gallery Section {%- endcomment -%}
    <div class="product-image-section">
      
      {%- comment -%} Main Image with Swipe {%- endcomment -%}
      <div class="main-image-container" id="mainImageContainer">
        {%- if product.featured_media -%}
          <img 
            src="{{ product.featured_media | img_url: '800x' }}" 
            alt="{{ product.title }}"
            class="main-image"
            id="mainImage"
            width="800"
            height="800">
          
          {%- comment -%} Navigation Arrows on Image {%- endcomment -%}
          {%- if product.media.size > 1 -%}
            <button class="image-nav-arrow left" id="imagePrev" aria-label="Previous image">
              ‹
            </button>
            <button class="image-nav-arrow right" id="imageNext" aria-label="Next image">
              ›
            </button>
            <div class="image-counter" id="imageCounter">1 / {{ product.media.size }}</div>
            <div class="swipe-hint">← Swipe →</div>
          {%- endif -%}
          
          <div class="zoom-hint">🔍 Tap to zoom</div>
        {%- else -%}
          <div class="no-image">💎</div>
        {%- endif -%}
      </div>

      {%- comment -%} Thumbnail Gallery - Scrollable {%- endcomment -%}
      {%- if product.media.size > 1 -%}
        <div class="thumbnails-scroll-container" id="thumbnailsContainer">
          <div class="thumbnails-scroll-track">
            {%- for media in product.media limit: 10 -%}
              <div class="thumb-item {% if forloop.first %}active{% endif %}"
                   data-index="{{ forloop.index0 }}"
                   data-image-url="{{ media | img_url: '800x' }}">
                <img src="{{ media | img_url: '150x' }}" width="150" height="150" alt="View {{ forloop.index }}">
              </div>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} Product Info Section {%- endcomment -%}
    <div class="product-info-section">
      
      <form action="/cart/add" method="post" id="productForm">
        <input type="hidden" name="id" id="variantId" value="{{ product.selected_or_first_available_variant.id }}">
        
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div class="option-group">
              <label class="option-title">{{ option.name }}</label>
              <div class="option-buttons">
                {%- for value in option.values -%}
                  <input 
                    type="radio" 
                    name="option-{{ option.name | handle }}"
                    value="{{ value }}"
                    id="opt-{{ option.name | handle }}-{{ value | handle }}"
                    data-option-position="{{ option.position }}"
                    {% if option.selected_value == value %}checked{% endif %}
                    onchange="updateVariant()">
                  <label for="opt-{{ option.name | handle }}-{{ value | handle }}" class="option-btn">
                    {{ value }}
                  </label>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        {%- endunless -%}

        <div class="quantity-group">
          <label class="option-title">Quantity</label>
          <div class="qty-selector">
            <button type="button" class="qty-btn" onclick="updateQty(-1)">−</button>
            <input type="number" name="quantity" value="1" min="1" class="qty-input" id="qtyInput">
            <button type="button" class="qty-btn" onclick="updateQty(1)">+</button>
          </div>
        </div>

        <div class="action-buttons">
          <button type="submit" class="btn-add-cart" id="addToCartBtn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="9" cy="21" r="1"></circle>
              <circle cx="20" cy="21" r="1"></circle>
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
            </svg>
            ADD TO CART
          </button>
          <button type="button" class="btn-buy-now" onclick="buyNow()">
            BUY IT NOW
          </button>
        </div>
      </form>

      {%- if product.description != blank -%}
        <div class="description-box">
          {{ product.description }}
        </div>
      {%- endif -%}

    </div>
  </div>
</div>

{%- comment -%} Zoom Modal {%- endcomment -%}
<div class="zoom-overlay" id="zoomOverlay" onclick="closeZoom()">
  <span class="zoom-close">×</span>
  <img src="" width="1200" height="1200" alt="Zoomed" class="zoom-image" id="zoomImage">
</div>

{%- comment -%} Product JSON for variant selection {%- endcomment -%}
<script>
  window.productJSON = {{ product | json }};
</script>

<style>
/* Reset & Base */
.product-lumiere-page {
  padding: 7rem 0 3rem;
  background: #fafafa;
  font-family: 'Montserrat', Arial, sans-serif;
}

/* ============================================
   TITLE BAR (Fixed Top)
   ============================================ */

.product-title-bar {
  background: white;
  border-bottom: 1px solid #e0e0e0;
  padding: 2rem 5%;
  margin-bottom: 2rem;
}

.title-container {
  max-width: 1400px;
  margin: 0 auto;
}

.product-main-title {
  font-size: 2rem;
  font-weight: 300;
  letter-spacing: 2px;
  margin-bottom: 1rem;
  color: #1a1a1a;
  font-family: 'Cormorant Garamond', Georgia, serif;
}

.product-main-price {
  display: flex;
  align-items: center;
  gap: 1rem;
  flex-wrap: wrap;
}

.price-current {
  font-size: 1.8rem;
  font-weight: 700;
  color: #d4af37;
}

.price-original {
  font-size: 1.4rem;
  color: #999;
  text-decoration: line-through;
}

.sale-tag {
  background: linear-gradient(135deg, #d4af37, #f4c2c2);
  color: white;
  padding: 0.3rem 0.8rem;
  border-radius: 15px;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 1px;
}

/* ============================================
   MAIN CONTENT
   ============================================ */

.product-main-content {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 5%;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  align-items: start;
}

/* ============================================
   IMAGE SECTION
   ============================================ */

.product-image-section {
  position: sticky;
  top: 150px;
}

.main-image-container {
  width: 100%;
  height: 500px;
  background: white;
  border-radius: 8px;
  margin-bottom: 1rem;
  overflow: hidden;
  position: relative;
  box-shadow: 0 4px 20px rgba(0,0,0,0.06);
  touch-action: pan-y pinch-zoom;
  user-select: none;
  cursor: pointer;
}

.main-image-container:hover {
  cursor: zoom-in;
}

.main-image {
  width: 100%;
  height: 100%;
  object-fit: contain;
  transition: transform 0.3s;
  pointer-events: auto;
  cursor: zoom-in;
}

.main-image-container:hover .main-image {
  transform: scale(1.05);
}

/* FIXED: Improved zoom hint */
.zoom-hint {
  position: absolute;
  bottom: 1rem;
  right: 1rem;
  background: rgba(0, 0, 0, 0.8);
  color: white;
  padding: 0.5rem 1rem;
  border-radius: 20px;
  font-size: 0.8rem;
