/* ============================================
   ZOOM MODAL - FIXED
   ============================================ */

.zoom-overlay {
  display: none;
  position: fixed;
  z-index: 99999;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.95);
  cursor: zoom-out;
  padding: 3rem;
  align-items: center;
  justify-content: center;
