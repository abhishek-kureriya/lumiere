/* ============================================
   PRODUCT INFO
   ============================================ */

.product-info-section {
  padding: 1rem 0;
}

.option-group,
.quantity-group {
  margin-bottom: 2rem;
}

.option-title {
  display: block;
  font-size: 0.85rem;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  margin-bottom: 0.8rem;
