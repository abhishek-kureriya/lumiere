</style>

<script>
// Global variables
let currentImageIndex = 0;
let productImages = [];
let touchStartX = 0;
let touchEndX = 0;
let isSwiping = false;

// Initialize on page load
document.addEventListener('DOMContentLoaded', function() {
  initializeImageGallery();
  initializeForm();
});

// Initialize image gallery with swipe
function initializeImageGallery() {
  const container = document.getElementById('mainImageContainer');
  const mainImage = document.getElementById('mainImage');
  const thumbItems = document.querySelectorAll('.thumb-item');
  
  if (!container || !mainImage) return;
  
  // Build images array
  thumbItems.forEach((thumb, index) => {
    productImages.push({
      url: thumb.dataset.imageUrl,
      index: index
    });
  });
  
  // Touch events for main image
  container.addEventListener('touchstart', handleTouchStart, { passive: true });
  container.addEventListener('touchmove', handleTouchMove, { passive: true });
  container.addEventListener('touchend', handleTouchEnd, { passive: true });
  
  // FIXED: Click on container to zoom (not just image)
  container.addEventListener('click', function(e) {
    // Don't zoom if clicking on navigation arrows
    if (e.target.classList.contains('image-nav-arrow') || 
        e.target.closest('.image-nav-arrow')) {
      return;
    }
    
    if (!isSwiping) {
      const imageUrl = mainImage.src;
      openZoom(imageUrl);
    }
  });
  
  // Arrow button clicks
  const prevBtn = document.getElementById('imagePrev');
  const nextBtn = document.getElementById('imageNext');
  
  if (prevBtn) {
    prevBtn.addEventListener('click', (e) => {
      e.stopPropagation(); // Prevent zoom from triggering
      navigateImage(-1);
    });
  }
  
  if (nextBtn) {
    nextBtn.addEventListener('click', (e) => {
      e.stopPropagation(); // Prevent zoom from triggering
      navigateImage(1);
    });
  }
  
  // Thumbnail clicks
  thumbItems.forEach((thumb, index) => {
    thumb.addEventListener('click', () => {
      currentImageIndex = index;
      updateMainImage();
    });
  });
}

// Touch handlers for main image
function handleTouchStart(e) {
  touchStartX = e.touches[0].clientX;
  touchEndX = touchStartX;
  isSwiping = false;
}

function handleTouchMove(e) {
  touchEndX = e.touches[0].clientX;
  const diff = Math.abs(touchStartX - touchEndX);
  if (diff > 10) {
    isSwiping = true;
  }
}

function handleTouchEnd(e) {
  if (!isSwiping) return;
  
  const swipeThreshold = 50;
  const diff = touchStartX - touchEndX;
  
  if (Math.abs(diff) > swipeThreshold) {
    if (diff > 0) {
      // Swiped left - next image
      navigateImage(1);
    } else {
      // Swiped right - previous image
      navigateImage(-1);
    }
  }
  
  setTimeout(() => {
    isSwiping = false;
  }, 100);
}

// Navigate between images
function navigateImage(direction) {
  if (productImages.length === 0) return;
  
  currentImageIndex += direction;
  
  // Loop around
  if (currentImageIndex < 0) {
    currentImageIndex = productImages.length - 1;
  } else if (currentImageIndex >= productImages.length) {
    currentImageIndex = 0;
  }
  
  updateMainImage();
}

// Update main image and thumbnails
function updateMainImage() {
  const mainImage = document.getElementById('mainImage');
  const counter = document.getElementById('imageCounter');
  const thumbItems = document.querySelectorAll('.thumb-item');
  const container = document.getElementById('thumbnailsContainer');
  
  if (mainImage && productImages[currentImageIndex]) {
    mainImage.src = productImages[currentImageIndex].url;
  }
  
  if (counter) {
    counter.textContent = `${currentImageIndex + 1} / ${productImages.length}`;
  }
  
  // Update active thumbnail
  thumbItems.forEach((thumb, index) => {
    if (index === currentImageIndex) {
      thumb.classList.add('active');
      // Scroll thumbnail into view
      if (container) {
        const thumbLeft = thumb.offsetLeft;
        const thumbWidth = thumb.offsetWidth;
        const containerWidth = container.offsetWidth;
        const scrollLeft = thumbLeft - (containerWidth / 2) + (thumbWidth / 2);
        container.scrollTo({
          left: scrollLeft,
          behavior: 'smooth'
        });
      }
    } else {
      thumb.classList.remove('active');
    }
  });
}

// Quantity controls
function updateQty(change) {
  const input = document.getElementById('qtyInput');
  const newVal = Math.max(1, parseInt(input.value) + change);
  input.value = newVal;
}

// FIXED: Zoom functions
function openZoom(imageUrl) {
  const overlay = document.getElementById('zoomOverlay');
  const zoomImage = document.getElementById('zoomImage');
  
  if (!overlay || !zoomImage) {
    console.error('Zoom overlay or image element not found');
    return;
  }
  
  // Set the image source
  zoomImage.src = imageUrl;
  
  // Show the overlay
  overlay.classList.add('active');
  
  // Prevent body scroll when zoom is open
  document.body.style.overflow = 'hidden';
}

function closeZoom() {
  const overlay = document.getElementById('zoomOverlay');
  
  if (!overlay) return;
  
  overlay.classList.remove('active');
  
  // Restore body scroll
  document.body.style.overflow = '';
}

// FIXED: Close zoom with Escape key
document.addEventListener('keydown', function(e) {
  if (e.key === 'Escape') {
    closeZoom();
  }
});

// Variant selection
function updateVariant() {
  if (!window.productJSON || !window.productJSON.variants) return;
  
  const selectedOptions = {};
  document.querySelectorAll('input[type="radio"]:checked').forEach(input => {
    const position = input.getAttribute('data-option-position');
    if (position) {
      selectedOptions[`option${position}`] = input.value;
    }
  });
  
  const matchingVariant = window.productJSON.variants.find(variant => {
    return Object.keys(selectedOptions).every(key => {
      return variant[key] === selectedOptions[key];
    });
  });
  
  if (matchingVariant) {
    document.getElementById('variantId').value = matchingVariant.id;
  }
}

// Update cart count in header
function updateCartCount(itemCount) {
  const cartCountElements = document.querySelectorAll(
    '.cart-count, .cart-count-bubble, [data-cart-count], .header__icon--cart .icon__fallback-text, .cart-link__bubble'
  );
  
  cartCountElements.forEach(element => {
    if (element.textContent !== undefined) {
      element.textContent = itemCount;
    }
    
    if (element.hasAttribute('data-cart-count')) {
      element.setAttribute('data-cart-count', itemCount);
    }
    
    if (itemCount > 0) {
      element.style.display = '';
      element.classList.remove('hidden');
    } else {
      if (element.classList.contains('cart-count-bubble') || element.classList.contains('cart-link__bubble')) {
        element.style.display = 'none';
      }
    }
  });
  
  document.dispatchEvent(new CustomEvent('cart:updated', {
    detail: { itemCount: itemCount }
  }));
}

// Refresh cart drawer content
function refreshCartDrawer() {
  fetch(window.Shopify?.routes?.root || '/' + '?section_id=cart-drawer')
    .then(response => response.text())
    .then(html => {
      const parser = new DOMParser();
      const doc = parser.parseFromString(html, 'text/html');
      
      const drawerSelectors = [
        'cart-drawer',
        '[data-cart-drawer]',
        '#CartDrawer',
        '.cart-drawer',
        '.drawer__inner',
        '#cart-drawer-items',
        '[id*="cart-drawer"]',
        '[class*="cart-drawer"]'
      ];
      
      drawerSelectors.forEach(selector => {
        const newContent = doc.querySelector(selector);
        const currentDrawer = document.querySelector(selector);
        
        if (newContent && currentDrawer) {
          const newInner = newContent.innerHTML;
          if (newInner) {
            currentDrawer.innerHTML = newInner;
          }
        }
      });
      
      document.dispatchEvent(new CustomEvent('cart:refresh'));
      
      if (typeof window.refreshCart === 'function') {
        window.refreshCart();
      }
      
      if (window.theme && typeof window.theme.updateCart === 'function') {
        window.theme.updateCart();
      }
    })
    .catch(error => {
      console.log('Could not refresh cart drawer content:', error);
      reloadCartDrawerAjax();
    });
}

function reloadCartDrawerAjax() {
  fetch('/cart.js')
    .then(response => response.json())
    .then(cart => {
      const cartDrawer = document.querySelector('cart-drawer, [data-cart-drawer], #CartDrawer, .cart-drawer');
      if (cartDrawer) {
        const cartItemsContainer = cartDrawer.querySelector('.cart-items, [data-cart-items], .drawer__cart-items-wrapper');
        if (cartItemsContainer && cart.items) {
          let itemsHTML = '';
          cart.items.forEach(item => {
            itemsHTML += `
              <div class="cart-item">
                <img src="${item.image}" alt="${item.title}" width="100">
                <div>
                  <h4>${item.title}</h4>
                  <p>Qty: ${item.quantity}</p>
                  <p>${(item.price / 100).toFixed(2)}</p>
                </div>
              </div>
            `;
          });
          cartItemsContainer.innerHTML = itemsHTML;
        }
        
        const totalElement = cartDrawer.querySelector('.cart-total, [data-cart-total], .totals__subtotal-value');
        if (totalElement) {
          totalElement.textContent = (cart.total_price / 100).toFixed(2);
        }
      }
    })
    .catch(error => {
      console.log('Could not reload cart via AJAX:', error);
    });
}

function openCartDrawer() {
  const cartDrawer = document.querySelector('cart-drawer, [data-cart-drawer], #CartDrawer, .cart-drawer');
  
  if (!cartDrawer) return;
  
  if (typeof cartDrawer.open === 'function') {
    cartDrawer.open();
    return;
  }
  
  cartDrawer.classList.add('is-open', 'active', 'animate');
  cartDrawer.setAttribute('aria-hidden', 'false');
  
  const overlay = document.querySelector('.drawer-overlay, [data-drawer-overlay], .cart-drawer-overlay');
  if (overlay) {
    overlay.classList.add('is-visible');
  }
  
  const cartIcon = document.querySelector('[data-cart-icon], .header__icon--cart, .cart-link');
  if (!cartDrawer.classList.contains('is-open') && cartIcon) {
    setTimeout(() => {
      cartIcon.click();
    }, 50);
  }
  
  document.dispatchEvent(new CustomEvent('cart:open'));
}

function buyNow() {
  const form = document.getElementById('productForm');
  const formData = new FormData(form);
  
  fetch('/cart/add.js', {
    method: 'POST',
    body: formData
  })
  .then(response => response.json())
  .then(data => {
    window.location.href = '/checkout';
  })
  .catch(error => {
    console.error('Error:', error);
    alert('There was an error. Please try again.');
  });
}

function initializeForm() {
  const form = document.getElementById('productForm');
  const addToCartBtn = document.getElementById('addToCartBtn');
  
  if (!form || !addToCartBtn) return;
  
  form.addEventListener('submit', function(e) {
    e.preventDefault();
    
    const formData = new FormData(form);
    
    addToCartBtn.disabled = true;
    addToCartBtn.innerHTML = 'ADDING...';
    
    fetch('/cart/add.js', {
      method: 'POST',
      body: formData
    })
    .then(response => response.json())
    .then(data => {
      addToCartBtn.innerHTML = '✓ ADDED';
      
      fetch('/cart.js')
        .then(response => response.json())
        .then(cart => {
          updateCartCount(cart.item_count);
          refreshCartDrawer();
          
          setTimeout(() => {
            openCartDrawer();
          }, 100);
        })
        .catch(error => {
          console.error('Error updating cart count:', error);
        });
      
      setTimeout(() => {
        addToCartBtn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>ADD TO CART';
        addToCartBtn.disabled = false;
      }, 2000);
    })
    .catch(error => {
      console.error('Error:', error);
      addToCartBtn.innerHTML = 'ERROR - TRY AGAIN';
      addToCartBtn.disabled = false;
      
      setTimeout(() => {
        addToCartBtn.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>ADD TO CART';
      }, 2000);
    });
  });
}
