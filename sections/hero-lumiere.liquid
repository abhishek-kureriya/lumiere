<script>
// EXACT COPY OF WORKING PRODUCT PAGE CAROUSEL LOGIC
let heroCurrentIndex = 0;
let heroSlides = [];
let heroTouchStartX = 0;
let heroTouchEndX = 0;
let heroIsSwiping = false;

document.addEventListener('DOMContentLoaded', function() {
  initializeHeroCarousel();
});

function initializeHeroCarousel() {
  const container = document.getElementById('heroImageContainer');
  const slides = document.querySelectorAll('.hero-image-slide');
  const dots = document.querySelectorAll('.hero-dot');
  
  if (!container || slides.length === 0) return;
  
  // Build slides array
  slides.forEach((slide, index) => {
    const mainImg = slide.querySelector('.hero-slide-main');
    heroSlides.push({
      element: slide,
      index: index,
      url: mainImg ? mainImg.dataset.slideUrl : ''
    });
  });
  
  // Touch events - EXACT SAME AS PRODUCT PAGE
  container.addEventListener('touchstart', handleHeroTouchStart, { passive: true });
  container.addEventListener('touchmove', handleHeroTouchMove, { passive: true });
  container.addEventListener('touchend', handleHeroTouchEnd, { passive: true });
  
  // Arrow buttons
  const prevBtn = document.getElementById('heroPrev');
  const nextBtn = document.getElementById('heroNext');
  
  if (prevBtn) {
    prevBtn.addEventListener('click', () => navigateHero(-1));
  }
  
  if (nextBtn) {
    nextBtn.addEventListener('click', () => navigateHero(1));
  }
  
  // Dots
  dots.forEach((dot, index) => {
    dot.addEventListener('click', () => {
      heroCurrentIndex = index;
      updateHeroSlide();
    });
  });
}

// Touch handlers - EXACT COPY FROM PRODUCT PAGE
function handleHeroTouchStart(e) {
  heroTouchStartX = e.touches[0].clientX;
  heroTouchEndX = heroTouchStartX;
  heroIsSwiping = false;
}

function handleHeroTouchMove(e) {
  heroTouchEndX = e.touches[0].clientX;
  const diff = Math.abs(heroTouchStartX - heroTouchEndX);
  if (diff > 10) {
    heroIsSwiping = true;
  }
}

function handleHeroTouchEnd(e) {
  if (!heroIsSwiping) return;
  
  const swipeThreshold = 50;
  const diff = heroTouchStartX - heroTouchEndX;
  
  if (Math.abs(diff) > swipeThreshold) {
    if (diff > 0) {
      // Swiped left - check for swap image first
      const currentSlide = heroSlides[heroCurrentIndex].element;
      const swapImg = currentSlide.querySelector('.hero-slide-swap');
      
      if (swapImg && !swapImg.classList.contains('visible')) {
        // Show swap image
        swapImg.classList.add('visible');
      } else {
        // Next slide
        navigateHero(1);
      }
    } else {
      // Swiped right - check if swap is visible
      const currentSlide = heroSlides[heroCurrentIndex].element;
      const swapImg = currentSlide.querySelector('.hero-slide-swap');
      
      if (swapImg && swapImg.classList.contains('visible')) {
        // Hide swap image
        swapImg.classList.remove('visible');
      } else {
        // Previous slide
        navigateHero(-1);
      }
    }
  }
  
  setTimeout(() => {
    heroIsSwiping = false;
  }, 100);
}

function navigateHero(direction) {
  if (heroSlides.length === 0) return;
  
  heroCurrentIndex += direction;
  
  // Loop around
  if (heroCurrentIndex < 0) {
    heroCurrentIndex = heroSlides.length - 1;
  } else if (heroCurrentIndex >= heroSlides.length) {
    heroCurrentIndex = 0;
  }
  
  updateHeroSlide();
}

function updateHeroSlide() {
  const slides = document.querySelectorAll('.hero-image-slide');
  const counter = document.getElementById('heroCounter');
  const dots = document.querySelectorAll('.hero-dot');
  
  slides.forEach((slide, index) => {
    if (index === heroCurrentIndex) {
      slide.classList.add('active');
    } else {
      slide.classList.remove('active');
      // Reset swap images on inactive slides
      const swapImg = slide.querySelector('.hero-slide-swap');
      if (swapImg) {
        swapImg.classList.remove('visible');
      }
    }
  });
  
  if (counter) {
    counter.textContent = `${heroCurrentIndex + 1} / ${heroSlides.length}`;
  }
  
  dots.forEach((dot, index) => {
    if (index === heroCurrentIndex) {
      dot.classList.add('active');
    } else {
      dot.classList.remove('active');
    }
  });
}
</script>

