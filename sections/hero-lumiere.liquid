  color: white;
  padding: 0.8rem 1.5rem;
  border-radius: 25px;
  font-size: 0.85rem;
  font-weight: 600;
  opacity: 0;
  pointer-events: none;
  animation: swipeHintFade 3s ease-in-out 1s;
  z-index: 5;
}

@keyframes swipeHintFade {
  0%, 100% { opacity: 0; }
  20%, 80% { opacity: 1; }
}

.hero-dots-container {
  display: flex;
  justify-content: center;
  gap: 0.8rem;
  margin-top: 1rem;
}

.hero-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.2);
  border: 2px solid rgba(212, 175, 55, 0.3);
  cursor: pointer;
  transition: all 0.3s;
