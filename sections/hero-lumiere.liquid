{% comment %}
===========================================
PREMIUM HERO SECTIONS - FIXED WITH WORKING SWIPE
Based on working product page carousel logic
Updated: CI/CD Test - {{ 'now' | date: "%Y-%m-%d %H:%M" }}
===========================================
{% endcomment %}

{%- assign hero_style = section.settings.hero_style | default: 'minimal-split' -%}

{%- if hero_style == 'minimal-split' -%}
<section class="hero-minimal-split">
  <div class="hero-split-container">
    <div class="hero-split-content">
      {%- if section.settings.hero_badge != blank -%}
        {%- if section.settings.hero_badge_link != blank -%}
          <a href="{{ section.settings.hero_badge_link }}" class="hero-badge hero-badge-link">
            {{ section.settings.hero_badge }}
          </a>
        {%- else -%}
          <div class="hero-badge">{{ section.settings.hero_badge }}</div>
        {%- endif -%}
      {%- endif -%}
      
      {%- if section.settings.hero_heading != blank -%}
        <h1 class="hero-split-heading">{{ section.settings.hero_heading }}</h1>
      {%- endif -%}
      
      {%- if section.settings.hero_subheading != blank -%}
        <p class="hero-split-subheading">{{ section.settings.hero_subheading }}</p>
      {%- endif -%}
      
      <div class="hero-split-actions">
        {%- if section.settings.hero_button_text != blank -%}
          <a href="{{ section.settings.hero_button_link }}" class="hero-btn-primary">
            {{ section.settings.hero_button_text }}
          </a>
        {%- endif -%}
        
        {%- if section.settings.hero_button_secondary_text != blank -%}
          <a href="{{ section.settings.hero_button_secondary_link }}" class="hero-btn-secondary">
            {{ section.settings.hero_button_secondary_text }}
          </a>
        {%- endif -%}
      </div>
      
      {%- if section.settings.show_trust_indicators -%}
        <div class="hero-trust-indicators">
          <div class="trust-item">
            <span class="trust-value">10,000+</span>
            <span class="trust-label">Happy Customers</span>
          </div>
          <div class="trust-item">
            <span class="trust-value">4.9★</span>
            <span class="trust-label">Average Rating</span>
          </div>
          <div class="trust-item">
            <span class="trust-value">🚀</span>
            <span class="trust-label" style="color: #e74c3c;">CI TEST</span>
          </div>
          <div class="trust-item">
            <span class="trust-value">100%</span>
            <span class="trust-label">Authentic</span>
          </div>
        </div>
      {%- endif -%}
    </div>
    
    <div class="hero-split-image">
      {%- if section.blocks.size > 0 -%}
        <div class="hero-image-container" id="heroImageContainer">
          <div class="hero-main-image-wrapper">
            {%- for block in section.blocks -%}
              <div class="hero-image-slide {% if forloop.first %}active{% endif %}" data-slide-index="{{ forloop.index0 }}">
                {%- if block.settings.slide_image != blank -%}
                  <img 
                    src="{{ block.settings.slide_image | image_url: width: 1200 }}" 
                    alt="{{ block.settings.slide_image.alt | default: 'Hero image' }}"
                    class="hero-slide-image hero-slide-main"
                    data-slide-url="{{ block.settings.slide_image | image_url: width: 1200 }}" width="800"
            height="800">
                {%- endif -%}
                
                {%- if block.settings.slide_image_swap != blank -%}
                  <img 
                    src="{{ block.settings.slide_image_swap | image_url: width: 1200 }}" 
                    alt="{{ block.settings.slide_image_swap.alt | default: 'Alternate image' }}"
                    class="hero-slide-image hero-slide-swap" width="800"
            height="800"> 
                {%- endif -%}
                
                {%- if block.settings.slide_caption != blank -%}
                  <div class="hero-slide-caption">{{ block.settings.slide_caption }}</div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
          
          {%- if section.blocks.size > 1 -%}
            <button class="hero-nav-arrow left" id="heroPrev">‹</button>
            <button class="hero-nav-arrow right" id="heroNext">›</button>
          <!-- ><div class="hero-counter" id="heroCounter">1 / {{ section.blocks.size }}</div> -->
          {%- endif -%}
          
          {%- if section.settings.show_swap_hint -%}
            <div class="hero-swipe-hint">← Swipe to compare →</div>
          {%- endif -%}
        </div>
        
        {%- if section.blocks.size > 1 -%}
          <div class="hero-dots-container">
            {%- for block in section.blocks -%}
              <button class="hero-dot {% if forloop.first %}active{% endif %}" data-dot-index="{{ forloop.index0 }}"></button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- elsif section.settings.hero_image != blank -%}
        {{ section.settings.hero_image | image_url: width: 1200 | image_tag: class: 'hero-static-img' }}
      {%- else -%}
        <div class="hero-placeholder"></div>
      {%- endif -%}
    </div>
  </div>
</section>

{%- elsif hero_style == 'centered-card' -%}
<section class="hero-centered-card">
  <div class="hero-background-wrapper">
    {%- if section.settings.hero_image != blank -%}
      {{ section.settings.hero_image | image_url: width: 2000 | image_tag: class: 'hero-bg-image' }}
    {%- endif -%}
    <div class="hero-overlay"></div>
  </div>
  
  <div class="hero-card-container">
    <div class="hero-content-card">
      {%- if section.settings.hero_badge != blank -%}
        <div class="hero-badge-centered">{{ section.settings.hero_badge }}</div>
      {%- endif -%}
      
      {%- if section.settings.hero_heading != blank -%}
        <h1 class="hero-card-heading">{{ section.settings.hero_heading }}</h1>
      {%- endif -%}
      
      {%- if section.settings.hero_subheading != blank -%}
        <p class="hero-card-subheading">{{ section.settings.hero_subheading }}</p>
      {%- endif -%}
      
      {%- if section.settings.hero_button_text != blank -%}
        <a href="{{ section.settings.hero_button_link }}" class="hero-card-button">
          {{ section.settings.hero_button_text }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{%- else -%}
<section class="hero-cinematic">
  <div class="hero-cinematic-bg">
    {%- if section.settings.hero_image != blank -%}
      {{ section.settings.hero_image | image_url: width: 2000 | image_tag: class: 'hero-cinematic-image' }}
    {%- endif -%}
    <div class="hero-cinematic-overlay"></div>
  </div>
  
  <div class="hero-cinematic-content">
    {%- if section.settings.hero_badge != blank -%}
      <div class="hero-badge-cinematic">{{ section.settings.hero_badge }}</div>
    {%- endif -%}
    
    {%- if section.settings.hero_heading != blank -%}
      <h1 class="hero-cinematic-heading">{{ section.settings.hero_heading }}</h1>
    {%- endif -%}
    
    {%- if section.settings.hero_subheading != blank -%}
      <p class="hero-cinematic-subheading">{{ section.settings.hero_subheading }}</p>
    {%- endif -%}
    
    {%- if section.settings.hero_button_text != blank -%}
      <a href="{{ section.settings.hero_button_link }}" class="hero-cinematic-button">
        {{ section.settings.hero_button_text }}
      </a>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

<style>
/* BASE STYLES */
.hero-minimal-split {
  position: relative;
  min-height: 75vh;
  max-height: 850px;
  background: #FEFDFB;
  padding: 2rem 5%;
  margin-top: 80px;
}

.hero-split-container {
  max-width: 1400px;
  margin: 0 auto;
  height: 100%;
