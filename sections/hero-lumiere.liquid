}

.hero-main-image-wrapper {
  width: 100%;
  height: 100%;
  position: relative;
}

.hero-image-slide {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.6s, visibility 0.6s;
}

.hero-image-slide.active {
  opacity: 1;
