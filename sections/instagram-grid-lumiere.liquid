{% comment %}
  LUMIÈRE – Instagram grid
  File: sections/instagram-grid-lumiere.liquid
{% endcomment %}

<section class="lum-ig lum-ig-{{ section.id }}">
  <div class="lum-ig__header">
    <h2 class="lum-ig__heading">{{ section.settings.heading }}</h2>
    {% if section.settings.handle != blank %}
      <a href="{{ section.settings.url }}" target="_blank" class="lum-ig__handle">@{{ section.settings.handle }}</a>
    {% endif %}
  </div>

  <div class="lum-ig__grid">
    {% for block in section.blocks %}
      {% if block.settings.image %}
        <a
          href="{{ block.settings.link | default: section.settings.url }}"
          class="lum-ig__item"
          target="_blank"
          {{ block.shopify_attributes }}
        >
          {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy' }}
        </a>
      {% endif %}
    {% endfor %}
  </div>
</section>

<style>
  .lum-ig-{{ section.id }} {
    padding: 50px 20px 40px;
    background: #ffffff;
  }
  .lum-ig-{{ section.id }} .lum-ig__header {
    max-width: 1100px;
    margin: 0 auto 18px;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }
  .lum-ig-{{ section.id }} .lum-ig__heading {
    font-family: "Playfair Display", serif;
    font-size: 20px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .lum-ig-{{ section.id }} .lum-ig__handle {
    font-size: 0.9rem;
    text-decoration: none;
    color: #d4af37;
  }
  .lum-ig-{{ section.id }} .lum-ig__grid {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 8px;
  }
  .lum-ig-{{ section.id }} .lum-ig__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 10px;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .lum-ig-{{ section.id }} .lum-ig__item:hover img {
    transform: translateY(-3px);
    box-shadow: 0 10px 20px rgba(0,0,0,0.15);
  }
  @media (max-width: 989px) {
    .lum-ig-{{ section.id }} .lum-ig__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 599px) {
    .lum-ig-{{ section.id }} .lum-ig__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

{% schema %}
{
  "name": "LUMIÈRE – Instagram grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "On Instagram" },
    { "type": "text", "id": "handle", "label": "Instagram handle (without @)", "default": "lumiere.official" },
    { "type": "url", "id": "url", "label": "Profile URL" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Post",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link to post (optional)" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    { "name": "LUMIERE – Instagram grid", "category": "Lumiere" }
  ]
}
{% endschema %}
